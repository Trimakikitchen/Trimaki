{
  "info": {
    "name": "TRIMAKI REST API Test Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "User Registration",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"phone\": \"+91 99999 55555\",\n  \"password\": \"jane123\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/register"
            }
          }
        },
        {
          "name": "User Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@trimaki.com\",\n  \"password\": \"customer123\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/login"
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List All Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/products"
            }
          }
        },
        {
          "name": "Get Categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/categories"
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Place Order (COD)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addressId\": \"[ADDRESS-UUID]\",\n  \"paymentMethod\": \"cod\",\n  \"couponCode\": \"TRIMAKI50\",\n  \"items\": [\n    {\n      \"productId\": \"[PRODUCT-UUID]\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/orders"
            }
          }
        }
      ]
    }
  ]
}
